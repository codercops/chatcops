{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatcops-website",
  // Built by `astro build` with @astrojs/cloudflare: the Starlight docs are
  // static assets in dist/, /api/chat and /api/visitors run in the Worker.
  // Workers Builds builds from the repo root (`pnpm -r build`, the widget
  // package has to build first) and deploys from here.
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
    // Default html_handling (auto-trailing-slash): Starlight's URLs and
    // canonicals end in a slash, so /core/tools redirects to /core/tools/.
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // chat.codercops.com is served through a route on a proxied placeholder DNS record
  // (AAAA 100::). www.chat.codercops.com is a custom domain only so it gets a
  // certificate; a zone redirect rule 301s it to chat.codercops.com.
  "routes": [
    { "pattern": "chat.codercops.com/*", "zone_name": "codercops.com" },
    { "pattern": "www.chat.codercops.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // No per-branch Preview URLs: develop and production are the only
  // environments.
  "preview_urls": false
}
