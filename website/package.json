{
  "name": "@chatcops/website",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "evals": "node ../packages/cli/dist/bin.js test --replay evals/docs-bot.chat.yaml",
    "evals:record": "node --env-file=../.env ../packages/cli/dist/bin.js test --record",
    "docs-index": "node --env-file=../.env scripts/docs-index.mjs",
    "docs-index:check": "node scripts/docs-index-check.mjs",
    "evals:citations": "node scripts/citation-eval.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.5",
    "@chatcops/core": "workspace:^",
    "@chatcops/server": "workspace:^",
    "@chatcops/store-cloudflare": "workspace:^",
    "@chatcops/widget": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "motion": "^12.35.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@chatcops/ingest": "workspace:^",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.0",
    "wrangler": "^4.146.0"
  }
}
