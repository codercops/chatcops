{
  "name": "@chatcops/store-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare D1, KV and Durable Objects storage for ChatCops",
  "keywords": [
    "chatcops",
    "storage",
    "cloudflare",
    "d1",
    "workers-kv",
    "durable-objects"
  ],
  "homepage": "https://chat.codercops.com",
  "bugs": "https://github.com/codercops/chatcops/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@chatcops/core": "workspace:^"
  },
  "devDependencies": {
    "@chatcops/core": "workspace:*",
    "@types/node": "^22",
    "miniflare": "^4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codercops/chatcops.git",
    "directory": "packages/store-cloudflare"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
