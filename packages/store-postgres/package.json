{
  "name": "@chatcops/store-postgres",
  "version": "0.2.0",
  "private": true,
  "description": "Postgres storage for ChatCops: conversations, counters, keys and analytics events",
  "keywords": [
    "chatcops",
    "chatbot",
    "postgres",
    "neon",
    "storage"
  ],
  "homepage": "https://chat.codercops.com",
  "bugs": "https://github.com/codercops/chatcops/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "chatcops-postgres": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@chatcops/core": "workspace:^",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chatcops/core": "workspace:*",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codercops/chatcops.git",
    "directory": "packages/store-postgres"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
