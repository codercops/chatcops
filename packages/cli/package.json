{
  "name": "@chatcops/cli",
  "version": "0.3.0",
  "description": "The chatcops command: build a knowledge index from your site and search it",
  "keywords": [
    "chatcops",
    "cli",
    "rag",
    "ingest"
  ],
  "homepage": "https://chat.codercops.com",
  "bugs": "https://github.com/codercops/chatcops/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "chatcops": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@chatcops/ingest": "workspace:^",
    "@chatcops/server": "workspace:^",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@chatcops/core": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codercops/chatcops.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@chatcops/core": "workspace:^",
    "@types/node": "^22",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
