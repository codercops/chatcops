{
  "name": "@chatcops/core",
  "version": "0.6.0",
  "description": "Core AI provider abstraction, tools, and knowledge base for ChatCops",
  "keywords": [
    "chatcops",
    "ai",
    "chatbot",
    "llm",
    "claude",
    "openai",
    "gemini",
    "tool-calling"
  ],
  "homepage": "https://chat.codercops.com",
  "bugs": "https://github.com/codercops/chatcops/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/claude": {
      "types": "./dist/providers/claude.d.ts",
      "import": "./dist/providers/claude.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./providers/gemini": {
      "types": "./dist/providers/gemini.d.ts",
      "import": "./dist/providers/gemini.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/provider": {
      "types": "./dist/testing/provider.d.ts",
      "import": "./dist/testing/provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@google/genai": "^2.30.0",
    "openai": "^7.39.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codercops/chatcops.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
