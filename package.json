{
  "name": "chatcops",
  "version": "0.0.0",
  "private": true,
  "description": "Universal embeddable AI chatbot widget",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check packages/*/src packages/*/tests website/src",
    "clean": "pnpm -r clean",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint",
    "size": "size-limit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "chatcops-widget-0-5": "npm:@chatcops/widget@0.5.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "MIT",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "wasm32"
      ]
    }
  }
}
